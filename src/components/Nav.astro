---
import { navLinks } from "../data/navLinks.ts";

const currentPath = Astro.url.pathname;
// normalize: remove trailing slash except root
const norm = (p: string) => (p !== "/" ? p.replace(/\/+$/, "") : "/");
const here = norm(currentPath);
---

<nav class="dotNav" aria-label="Landing menu" data-dotnav>
	<div class="dotNav__row">
		<ul class="dotNav__list">
			{
				navLinks.map((l) => {
					const isActive = norm(l.href) === here;
					return (
						<li class="dotNav__item">
							<a
								class={`dotNav__dot ${isActive ? "isActive" : ""}`}
								href={l.href}
								data-label={l.label}
								aria-label={l.label}
								aria-current={isActive ? "page" : undefined}
							/>
						</li>
					);
				})
			}
		</ul>
	</div>

	<div class="dotNav__labelBar" aria-hidden="true">
		<span class="dotNav__labelText" data-dotnav-label></span>
	</div>
</nav>

<script>
	const nav = document.querySelector<HTMLElement>("[data-dotnav]");
	if (nav) {
		const labelEl = nav.querySelector<HTMLElement>("[data-dotnav-label]");

		function showLabel(text: string) {
			if (!labelEl) return;
			labelEl.textContent = text;
			nav.classList.add("isShowingLabel");
		}

		function hideLabel() {
			nav.classList.remove("isShowingLabel");
			if (labelEl) labelEl.textContent = "";
		}

		nav.addEventListener("mouseover", (e: MouseEvent) => {
			const target = e.target;
			if (!(target instanceof Element)) return;

			const a = target.closest<HTMLAnchorElement>("a[data-label]");
			if (a) showLabel(a.dataset.label ?? "");
		});

		nav.addEventListener("focusin", (e: FocusEvent) => {
			const target = e.target;
			if (!(target instanceof Element)) return;

			const a = target.closest<HTMLAnchorElement>("a[data-label]");
			if (a) showLabel(a.dataset.label ?? "");
		});

		nav.addEventListener("mouseleave", hideLabel);

		nav.addEventListener("focusout", (e: FocusEvent) => {
			const rt = e.relatedTarget;
			if (rt && rt instanceof Node && nav.contains(rt)) return;
			hideLabel();
		});
	}
</script>

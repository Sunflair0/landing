---
import Shell from "../../../layouts/Shell.astro";
import { NAV_ITEMS, routeFor } from "../../../nav/navLinks";

const items = NAV_ITEMS.filter(
	(i) => i.group === "nursery" && i.lane === "workshop",
);
---

<Shell mode="nursery" title="Nursery – Workshop">
	<main class="page">
		<h1>Workshop</h1>
		<p>Everything starts here.</p>

		<ul>
			{
				items.map((i) => (
					<li>
						<a href={routeFor(i)}>{i.title}</a>
					</li>
				))
			}
		</ul>
	</main>
</Shell>

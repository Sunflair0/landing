---
type Group = "home" | "projects" | "labs" | "scenes" | "nursery" | "other";
type Lane = "workshop" | "doneish" | "library" | "archive" | "none";

type Props = {
	title?: string;
	description?: string;
	group?: Group;
	pageId?: string;
	lane?: Lane;
};

const {
	title = "Landings",
	description,
	group = "other",
	pageId = "none",
	lane = "none",
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{description ? <meta name="description" content={description} /> : null}
		<title>{title}</title>
		<link rel="stylesheet" href="/styles/main.css" />
	</head>

	<body data-group={group} data-page={pageId} data-lane={lane}>
		<slot />
	</body>
</html>

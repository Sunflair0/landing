---
import { routeFor, groupRoute, laneRoute, type NavItem, type Group, type Lane } from "../nav/navLinks";

type LaneBlock = { key: Lane; label: string; items: NavItem[] };

type Props = {
	id: string;
	title: string;
	group?: Group;
	items?: NavItem[];
	lanes?: LaneBlock[];
};

const { id, title, group, items = [], lanes = [] } = Astro.props as Props;
---

<section class="popover" id={id} aria-label={title}>
	{group ? (
		<a class="popover__title" href={groupRoute(group)}>{title}</a>
	) : (
		<div class="popover__title">{title}</div>
	)}

	{
		lanes.length ? (
			<div class="popover__lanes">
				{lanes.map((block) => (
					<div class="popover__lane">
						<a class="popover__laneTitle" href={laneRoute(block.key)}>
							{block.label}
						</a>
						<ul class="popover__list">
							{block.items.map((i) => (
								<li>
									<a class="popover__link" href={routeFor(i)}>
										{i.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		) : (
			<ul class="popover__list">
				{items.map((i) => (
					<li>
						<a class="popover__link" href={routeFor(i)}>
							{i.title}
						</a>
					</li>
				))}
			</ul>
		)
	}
</section>

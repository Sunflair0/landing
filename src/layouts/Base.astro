---
type Group = "home" | "projects" | "labs" | "scenes" | "nursery" | "other";
type Lane = "workshop" | "doneish" | "library" | "archive" | "none";

type Props = {
  title?: string;
  description?: string;
  group?: Group;
  pageId?: string;
  lane?: Lane;
  bodyClass?: string;
};

const {
  title = "Landings",
  description,
  group = "other",
  pageId = "none",
  lane = "none",
  bodyClass = "",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description ? <meta name="description" content={description} /> : null}
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />

    <!-- Your compiled CSS -->
    <link rel="stylesheet" href="/styles/main.css" />
  </head>

  <body
    class={bodyClass}
    data-group={group}
    data-page={pageId}
    data-lane={lane}
  >
    <slot />
  </body>
</html>

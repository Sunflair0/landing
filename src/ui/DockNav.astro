---
import PopoverMenu from "./PopoverMenu.astro";
import Icon from "./Icon.astro";
import {
  GROUPS,
  itemsForGroup,
  LANES,
  nurseryItemsForLane,
  groupRoute,
} from "../nav/navLinks";

type Variant = "home" | "page" | "entry";
type Props = { variant?: Variant };
const { variant = "home" } = Astro.props as Props;

// 1) remove nursery from “normal group popovers”
const groupsNoNursery = GROUPS.filter((g) => g.key !== "nursery");

// 2) Make a type for “group keys” from GROUPS (projects, labs, scenes, etc.)
type GroupKey = (typeof GROUPS)[number]["key"];

// 3) Add your “static pages” to the key universe
type StaticKey = "home" | "search" | "readme";

// 4) Everything the dock might render
type DockKey = StaticKey | GroupKey;

// 5) Entry variant: small set (NOTE: "scenes" plural)
const ENTRY_KEYS = ["projects", "labs", "scenes", "nursery"] as const satisfies readonly DockKey[];

// 6) Default variant: full set
const DEFAULT_KEYS = [
  "home",
  ...groupsNoNursery.map((g) => g.key),
  "nursery",
  "search",
  "readme",
] as const satisfies readonly DockKey[];

// 7) Pick which list to use
const keys = (variant === "entry" ? ENTRY_KEYS : DEFAULT_KEYS) as readonly DockKey[];

// --- helpers ---
const isStatic = (k: DockKey): k is StaticKey =>
  k === "home" || k === "search" || k === "readme";

const hrefFor = (k: DockKey) =>
  k === "home" ? "/" :
  k === "search" ? "/search" :
  k === "readme" ? "/readme" :
  groupRoute(k);

const labelFor = (k: DockKey) =>
  k === "home" ? "Home" :
  k === "search" ? "Search" :
  k === "readme" ? "Readme" :
  k[0].toUpperCase() + k.slice(1);

// 8) Icon picking, clean and centralized
const ICON_FOR_KEY: Record<DockKey, Parameters<typeof Icon>[0]["name"]> = {
  home: "house",
  search: "search",
  readme: "readme",

  projects: "projects",
  labs: "labs",
  scenes: "scene",
  nursery: "sprout",

  // if you have other groups later, TS will force you to add them here
} as const;
---
<nav class={`dock dock--${variant}`} aria-label="Dock navigation">
  <div class="dock__bar" data-dockbar>
    {keys.map((k) => (
      <a class="dock__btn" href={hrefFor(k)} aria-label={labelFor(k)} data-dock={k}>
        <Icon name={ICON_FOR_KEY[k]} class="dock__icon" />
      </a>
    ))}

    {variant !== "entry" &&
      groupsNoNursery.map((g) => (
        <PopoverMenu
          id={`menu-${g.key}`}
          title={g.label}
          group={g.key}
          items={itemsForGroup(g.key)}
        />
      ))}

    {variant !== "entry" && (
      <PopoverMenu
        id="menu-nursery"
        title="Nursery"
        group="nursery"
        lanes={LANES.map((l) => ({
          key: l.key,
          label: l.label,
          items: nurseryItemsForLane(l.key),
        }))}
      />
    )}

    {variant !== "entry" && (
      <script is:inline>
        // your existing popover JS unchanged
      </script>
    )}
  </div>
</nav>
